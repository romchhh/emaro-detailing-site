NEXT_PUBLIC_SITE_URL=https://emaroautocare.pl

# Optional on Vercel preview builds if NEXT_PUBLIC_SITE_URL is not set:
# VERCEL_URL is provided automatically by Vercel.

# Telegram lead notifications (server-only — never expose to the client)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Admin panel (/admin) — use a strong unique password in production
ADMIN_LOGIN=admin
ADMIN_PASSWORD=

# Optional: override CMS data directory (default: ./cms-data)
# CMS_DATA_DIR=/var/data/emaro-cms

# Optional search-console / webmaster verification codes:
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# NEXT_PUBLIC_YANDEX_VERIFICATION=
# NEXT_PUBLIC_BING_SITE_VERIFICATION=
